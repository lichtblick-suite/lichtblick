{
  "installCommand": "corepack enable yarn && corepack yarn install --immutable",
  "buildCommand": "corepack yarn web:build:prod",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144"
    }
  },
  "outputDirectory": "web/.webpack",
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "origin" },
        { "key": "Content-Security-Policy", "value": "base-uri 'self';" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "trailingSlash": false
}
